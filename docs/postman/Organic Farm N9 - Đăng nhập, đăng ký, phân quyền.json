        {
          "name": "Đăng ký Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Khách hàng mới\",\n  \"email\": \"{{registerEmail}}\",\n  \"phone\": \"0901234567\",\n  \"password\": \"12345678\",\n  \"password_confirmation\": \"12345678\",\n  \"role_name\": \"Admin\"\n}"
            },
            "description": "role_name Admin trong body bị bỏ qua. Tài khoản mới luôn là Customer."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'khach.' + Date.now() + '@organicfarm.vn';",
                  "pm.collectionVariables.set('registerEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng ký 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.user.role.role_name).to.eql('Customer');",
                  "pm.collectionVariables.set('customerToken', json.data.token);"
                ]
              }
            }
          ]
        }
      ],
      "description": ""
    },
