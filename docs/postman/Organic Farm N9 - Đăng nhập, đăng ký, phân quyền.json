    {
      "name": "06. Đặt hàng trừ kho FEFO & Thanh toán",
      "item": [
        {
          "name": "POST Tính phí ship & Lấy quote_token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipping/calculate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shipping",
                "calculate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"delivery_address\": \"65 Huỳnh Thúc Kháng, Quận 1, TP.HCM\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tính phí giao hàng & lấy quote_token thành công (200)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    const res = pm.response.json();\r",
                  "    const qt = res.data?.quote_token || res.quote_token;\r",
                  "    pm.collectionVariables.set(\"quote_token\", qt);\r",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Đặt hàng thành công & Trừ kho FEFO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "orders"
              ]
            },
