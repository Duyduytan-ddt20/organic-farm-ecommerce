{
  "info": {
    "name": "Organic Farm N9 - Đăng nhập, đăng ký, phân quyền",
    "description": "Luồng Sanctum: đăng ký Customer, đăng nhập 4 vai trò, kiểm tra middleware role, đăng xuất. Base URL mặc định http://127.0.0.1:8000. Tài khoản seed mật khẩu 12345678.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "registerEmail", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "salesToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "01. Công khai",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng ký Customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'khach.' + Date.now() + '@organicfarm.vn';",
                  "pm.collectionVariables.set('registerEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng ký 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.user.role.role_name).to.eql('Customer');",
                  "pm.collectionVariables.set('customerToken', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Khách hàng mới\",\n  \"email\": \"{{registerEmail}}\",\n  \"phone\": \"0901234567\",\n  \"password\": \"12345678\",\n  \"password_confirmation\": \"12345678\",\n  \"role_name\": \"Admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "role_name Admin trong body bị bỏ qua. Tài khoản mới luôn là Customer."
          }
        }
      ]
    },
